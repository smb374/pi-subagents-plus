{
  "name": "@smb374/pi-subagents-plus",
  "version": "0.1.0",
  "description": "An extension to extend @gotgenes/pi-subagents for personal needs",
  "keywords": [
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "subagents-plus"
  ],
  "homepage": "https://github.com/smb374/pi-subagents-plus#readme",
  "bugs": {
    "url": "https://github.com/smb374/pi-subagents-plus/issues"
  },
  "license": "BSD-3-Clause",
  "author": "Po-Yeh Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smb374/pi-subagents-plus.git"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "src/index.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint -c ./oxlint.config.ts ./*",
    "lint:fix": "oxlint -c ./oxlint.config.ts ./* --fix",
    "format": "oxfmt ./*",
    "format:check": "oxfmt --check ./*",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "test:package": "bun scripts/package-check.mjs",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "verify": "bun run check && bun run test:package",
    "prepack": "bun run verify"
  },
  "dependencies": {},
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.86.1",
    "@gotgenes/pi-subagents": "^21.7.5",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^4.1.10",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-rules": "0.4.3",
    "oxlint-tsgolint": "^7.0.2001",
    "typebox": "^1.3.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0 <27"
  },
  "packageManager": "bun@1.4.2",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
